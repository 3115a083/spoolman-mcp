# Copy this template to a private .env in your Dockge stack (never commit it).
OAUTH_PUBLIC_URL=https://oauth-mcp.example.com
MCP_BACKEND_URL=https://protected-mcp.example.com/mcp
GITHUB_CLIENT_ID=YOUR_GITHUB_OAUTH_CLIENT_ID
GITHUB_CLIENT_SECRET=YOUR_GITHUB_OAUTH_CLIENT_SECRET
GITHUB_OWNER_ID=YOUR_NUMERIC_GITHUB_USER_ID
OAUTH_JWT_SIGNING_KEY=REPLACE_WITH_OPENSSL_RAND_HEX_32
PANGOLIN_ACCESS_TOKEN_ID=YOUR_RESOURCE_ACCESS_TOKEN_ID
PANGOLIN_ACCESS_TOKEN=YOUR_RESOURCE_ACCESS_TOKEN
MCP_BACKEND_API_KEY=YOUR_EXISTING_MCP_API_KEY
